HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/planner.db
SESSION_TTL_HOURS=12
# true для HTTPS; false допустимо только для локального HTTP/LAN_ONLY с LAN_TLS=false.
COOKIE_SECURE=false
# Обязательно задайте длинный случайный секрет в production.
APP_SECRET=replace-with-at-least-32-random-characters
# Вместо значений можно указать APP_SECRET_FILE и ADMIN_PASSWORD_FILE.
# Только для первого запуска. После создания администратора переменные не используются.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-2026!
ADMIN_NAME=Администратор
